# EquipED local development environment
# For a new checkout, copy this file to .env and replace placeholder values.
# Do not overwrite an existing .env or commit real credentials.

# Application
APP_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
# Use one canonical browser origin. Change this to http://localhost:3000 when
# using Caddy; localhost:5173 is the Faculty Vite proxy fallback.
APP_PUBLIC_URL="http://localhost:5173"

# Address that outside callers (e.g. Google Colab through a tunnel) use to reach
# this API. Only needed for DPO training jobs: the download/upload links shown on
# the Training Data page use it. Bare origin only (no path); leave unset to use
# the local address. Point the tunnel at the backend port (default 8000).
# PUBLIC_BASE_URL="https://your-tunnel.example.com"

# Shared Neon PostgreSQL development database.
# Obtain the equiped_app password privately; never commit it. Percent-encode
# special password characters when inserting them into a connection URL.
DATABASE_URL="postgresql://equiped_app:<URL_ENCODED_PASSWORD>@<NEON_POOLED_HOST>:5432/<NEON_DATABASE>?sslmode=require"
# Use the project's pooled hostname for runtime access and keep TLS required.
# Neon access does not require Tailscale or the Windows PC to be online.
# For migrations, use the separately saved Neon owner connection with its
# DIRECT hostname (without -pooler), not the runtime login. Temporarily override
# DATABASE_URL for pnpm server:migrate, then return to equiped_app for runtime.
# Owner connection format (replace DATABASE_URL only while running migrations):
# DATABASE_URL="postgresql://<NEON_OWNER>:<URL_ENCODED_OWNER_PASSWORD>@<NEON_DIRECT_HOST>:5432/<NEON_DATABASE>?sslmode=require"
# Do not use the Windows equiped_owner credentials against the Neon project.
# The native PC database is retained only as a fallback, not a live replica.
# To use that fallback directly on the PC, supply its separate runtime password:
# DATABASE_URL="postgresql://equiped_app:<URL_ENCODED_PASSWORD>@127.0.0.1:5432/equiped?sslmode=prefer"
# Migration evidence and PC fallback backups: infra/postgres/README.md

# Session cookies are insecure only for local HTTP development.
# Production startup requires this to be true.
SESSION_COOKIE_SECURE=false

# Document storage is separate from PostgreSQL. Team development uses the
# existing approved R2 bucket; obtain its configuration privately and uncomment
# this block to read shared documents. Complete R2 configuration also selects R2
# automatically. Without it, storage defaults to this checkout's local uploads/.
# STORAGE_BACKEND="r2"
# R2_ACCOUNT_ID="<R2_ACCOUNT_ID>"
# R2_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
# R2_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
# R2_BUCKET_NAME="<R2_BUCKET_NAME>"
# A custom endpoint can replace R2_ACCOUNT_ID when required:
# R2_ENDPOINT_URL="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"

# Gmail SMTP
# Use a Google App Password, never the Gmail account password.
EMAIL_PROVIDER=smtp
EMAIL_FROM="EquipED <your-account@gmail.com>"
SMTP_USERNAME="your-account@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# These SMTP defaults normally do not need to be changed.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=10

# Local ChromaDB persistence. Omit to use the same default path.
# CHROMA_PERSIST_DIRECTORY="chroma_data"
# Alternatively, connect to a separately managed local Chroma HTTP server:
# CHROMA_HOST="127.0.0.1"
# CHROMA_PORT=8001
# CHROMA_SSL=false
# Use compatible client/server versions and preserve existing reference vectors.
# PostgreSQL restoration does not restore Chroma data or uploaded document files.

# Local/OpenAI-compatible model endpoint
LLM_PROVIDER="local"
LLM_MODEL_NAME="equiped-gemma3-4b-qat-q4"
# LLM_API_BASE="http://localhost:11434/v1"
# LLM_API_KEY="set-only-if-your-endpoint-requires-it"

# Optional per-agent model overrides
# LLM_MODEL_SME="optional-model-name"
# LLM_MODEL_COORD="optional-model-name"
# LLM_MODEL_GAD="optional-model-name"
# LLM_MODEL_ITSO="optional-model-name"

# Optional OCR for scanned PDFs
# TESSERACT_CMD="/usr/bin/tesseract"
# TESSERACT_LANG="eng+fil"
