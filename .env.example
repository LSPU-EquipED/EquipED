# EquipED Environment Config Scaffold
# Copy this to .env to configure local development.

# Application
APP_NAME="EquipED"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"
# Frontend runs locally in development.
CORS_ORIGINS="http://localhost:5173"

# Shared PostgreSQL for development (currently Neon).
# Replace with your team's development connection string.
# Example only — do not commit real credentials.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Optional local PostgreSQL fallback for validation / future pre-production checks:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equiped"

# Session Auth
SESSION_COOKIE_NAME="equiped_session"
SESSION_TTL_HOURS=24

# Optional first admin bootstrap
# Set all three together to create the first admin on startup.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Local ChromaDB persistent store per developer.
CHROMA_PERSIST_DIRECTORY="chroma_data"

# Optional LLM configuration. Keep empty if not needed yet.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Per-agent LLM model overrides (RPD-optimized, each gets its own TPM pool).
# When set, the agent uses the specified model instead of LLM_MODEL_NAME.
# LLM_MODEL_SME=llama-3.1-8b-instant
# LLM_MODEL_COORD=allam-2-7b
# LLM_MODEL_GAD=qwen/qwen3-32b
# LLM_MODEL_ITSO=openai/gpt-oss-20b

# Local OCR Settings (Tesseract)
# Production requires both 'eng' and 'fil' language packs.
# In development (APP_ENV="development"), the application remains usable for
# text-based PDFs even if Tesseract is not installed, but uploading scanned PDFs
# will fail with a user-friendly error.
# TESSERACT_CMD="/usr/bin/tesseract"
# TESSERACT_LANG="eng+fil"
# OCR_MAX_PAGES=25
# OCR_DPI=200
# OCR_MAX_PIXELS=8000000
# OCR_TIMEOUT_SECONDS=20
# OCR_CONCURRENCY=1
# OCR_SEMAPHORE_TIMEOUT_SECONDS=30
