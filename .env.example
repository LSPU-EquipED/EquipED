# EquipED Environment Config Scaffold
# Copy this to .env to configure local development.

# Application
APP_NAME="EquipED"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:5173"

# Postgres Database (Neon)
# Replace with your Neon connection string
DATABASE_URL="postgresql://neondb_owner:npg_mV5N8KoFUMkc@ep-silent-mouse-amp9zoq7-pooler.c-5.us-east-1.aws.neon.tech/neondb"

# Session Auth
SESSION_COOKIE_NAME="equiped_session"
SESSION_TTL_HOURS=24

# Optional first admin bootstrap
# Set all three together to create the first admin on startup.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# ChromaDB Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8001
