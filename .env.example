# EquipED Environment Config Scaffold
# Copy this to .env to configure local development.

# Application
APP_NAME="EquipED"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"
# Frontend runs locally in development.
CORS_ORIGINS="http://localhost:5173"

# Shared PostgreSQL for development (currently Neon).
# Replace with your team's development connection string.
# Example only — do not commit real credentials.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Optional local PostgreSQL fallback for validation / future pre-production checks:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equiped"

# Session Auth
SESSION_COOKIE_NAME="equiped_session"
SESSION_TTL_HOURS=24

# Optional first admin bootstrap
# Set all three together to create the first admin on startup.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Local ChromaDB per developer.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false

# Optional LLM configuration. Keep empty if not needed yet.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
