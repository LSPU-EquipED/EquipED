# EquipED Environment Config Scaffold
# Copy this to .env to configure local development.

# Application
APP_NAME="EquipED"
APP_VERSION="0.1.0"
API_PREFIX="/api/v1"
# Frontend runs locally in development.
CORS_ORIGINS="http://localhost:5173"

# Shared PostgreSQL for development (currently Neon).
# Replace with your team's development connection string.
# Example only — do not commit real credentials.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Optional local PostgreSQL fallback for validation / future pre-production checks:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equiped"

# Session Auth
SESSION_COOKIE_NAME="equiped_session"
SESSION_TTL_HOURS=24

# Optional first admin bootstrap
# Set all three together to create the first admin on startup.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Local ChromaDB persistent store per developer.
CHROMA_PERSIST_DIRECTORY="chroma_data"

# Local OpenAI-compatible LLM transport.
LLM_PROVIDER="local"
LLM_READINESS_TIMEOUT_SECONDS=2
EVALUATION_HEARTBEAT_STALE_SECONDS=300
LLM_MODEL_NAME="equiped-gemma3-4b-qat-q4"
# LLM_API_BASE="http://localhost:11434/v1"
LLM_RESPONSE_MODE="json_object"
# Maximum concurrent requests for the shared local transport.
LLM_INFLIGHT_LIMIT=4
LLM_RPM_LIMIT=0
LLM_TPM_LIMIT=0
LLM_LOCAL_QUOTA_ENABLED=false

# Optional per-agent LLM model overrides.
# When set, the agent uses the specified model instead of LLM_MODEL_NAME.
# LLM_MODEL_SME=""
# LLM_MODEL_COORD=""
# LLM_MODEL_GAD=""
# LLM_MODEL_ITSO=""

# Optional local-only Model Validation toxicity assessment.
# Keep disabled unless these point to an approved local/self-hosted,
# OpenAI-compatible classifier. Public endpoints are rejected at startup.
TOXICITY_ASSESSMENT_ENABLED=false
TOXICITY_API_BASE=""
TOXICITY_MODEL_NAME=""
TOXICITY_API_KEY=""
TOXICITY_REQUEST_TIMEOUT_SECONDS=30

# Local OCR Settings (Tesseract)
# Production requires both 'eng' and 'fil' language packs.
# In development (APP_ENV="development"), the application remains usable for
# text-based PDFs even if Tesseract is not installed, but uploading scanned PDFs
# will fail with a user-friendly error.
# TESSERACT_CMD="/usr/bin/tesseract"
# TESSERACT_LANG="eng+fil"
# OCR_MAX_PAGES=25
# OCR_DPI=200
# OCR_MAX_PIXELS=8000000
# OCR_TIMEOUT_SECONDS=20
# OCR_CONCURRENCY=1
# OCR_SEMAPHORE_TIMEOUT_SECONDS=30
# Six grouped SME prompts require up to roughly 14k chars on canonical sources.
SME_TOTAL_PROMPT_BUDGET_CHARS=15000
