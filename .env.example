# EquipED local development environment
# Copy this file to .env, then replace every placeholder value.

# Application
APP_ENV=development
CORS_ORIGINS="http://localhost:5173"
APP_PUBLIC_URL="http://localhost:5173"

# Address that outside callers (e.g. Google Colab through a tunnel) use to reach
# this API. Only needed for DPO training jobs: the download/upload links shown on
# the Training Data page use it. Bare origin only (no path); leave unset to use
# the local address. Point the tunnel at the backend port (default 8000).
# PUBLIC_BASE_URL="https://your-tunnel.example.com"

# Shared native PostgreSQL on the Windows PC (not Docker).
# Developer laptops must connect to Tailscale and have their IPv4 authorized
# in both the PC's Windows Firewall and pg_hba.conf before connecting.
# Obtain the equiped_app password privately; never commit it. Percent-encode
# special password characters when inserting them into a connection URL.
DATABASE_URL="postgresql://equiped_app:<URL_ENCODED_PASSWORD>@100.123.191.41:5432/equiped?sslmode=prefer"
# Tailscale encrypts traffic. sslmode=prefer supports this host without native
# PostgreSQL TLS; use sslmode=require only when PostgreSQL TLS is configured.
# When running the backend directly on the database PC, use localhost instead:
# DATABASE_URL="postgresql://equiped_app:<URL_ENCODED_PASSWORD>@127.0.0.1:5432/equiped?sslmode=prefer"
# Migrations need the separate equiped_owner credentials, not the runtime role.
# Temporarily override DATABASE_URL for pnpm server:migrate, then return to
# equiped_app before starting the backend. Do not use the postgres superuser.
# Setup, device authorization, and backups: infra/postgres/README.md

# Session cookies are insecure only for local HTTP development.
# Production startup requires this to be true.
SESSION_COOKIE_SECURE=false

# Gmail SMTP
# Use a Google App Password, never the Gmail account password.
EMAIL_PROVIDER=smtp
EMAIL_FROM="EquipED <your-account@gmail.com>"
SMTP_USERNAME="your-account@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# These SMTP defaults normally do not need to be changed.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=10

# Local ChromaDB persistence. Omit to use the same default path.
# CHROMA_PERSIST_DIRECTORY="chroma_data"

# Local/OpenAI-compatible model endpoint
LLM_PROVIDER="local"
LLM_MODEL_NAME="equiped-gemma3-4b-qat-q4"
# LLM_API_BASE="http://localhost:11434/v1"
# LLM_API_KEY="set-only-if-your-endpoint-requires-it"

# Optional per-agent model overrides
# LLM_MODEL_SME="optional-model-name"
# LLM_MODEL_COORD="optional-model-name"
# LLM_MODEL_GAD="optional-model-name"
# LLM_MODEL_ITSO="optional-model-name"

# Optional OCR for scanned PDFs
# TESSERACT_CMD="/usr/bin/tesseract"
# TESSERACT_LANG="eng+fil"
