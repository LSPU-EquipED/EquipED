# EquipED Production Environment Template
# Copy this file to .env.prod on your production server. NEVER commit .env.prod to git.

# Application
APP_ENV=production
ENVIRONMENT=production
# Restrict CORS to your official institutional production domain:
CORS_ORIGINS="https://equiped.lspu.edu.ph"
APP_PUBLIC_URL="https://equiped.lspu.edu.ph"

# Production PostgreSQL Database
# Dedicated production instance or isolated production Neon branch:
DATABASE_URL="postgresql://<prod-user>:<strong-prod-password>@<prod-db-host>:5432/equiped_prod?sslmode=require"
POSTGRES_DB=equiped_prod
POSTGRES_USER=equiped_admin
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD="generate-a-strong-random-password-here"

# Security & Sessions
# MANDATORY in production: Cookies must require HTTPS
SESSION_COOKIE_SECURE=true

# Initial Admin Bootstrap (only used on first deployment if no admin exists)
# Generate with: openssl rand -base64 24
BOOTSTRAP_ADMIN_EMAIL="admin@lspu.edu.ph"
BOOTSTRAP_ADMIN_PASSWORD="generate-a-strong-admin-password"

# Production Email (SMTP or Resend)
EMAIL_PROVIDER=smtp
EMAIL_FROM="EquipED <notifications@lspu.edu.ph>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME="production-system-account@lspu.edu.ph"
SMTP_PASSWORD="production-google-app-password"

# Production LLM Provider
# Dedicated production API key with budget alerts and strict quota limits:
LLM_PROVIDER="local"
LLM_MODEL_NAME="equiped-gemma3-4b-qat-q4"
# For cloud LLMs:
# ANTHROPIC_API_KEY="sk-ant-api03-production-key-here"
# LLM_API_BASE="https://api.anthropic.com/v1"

# Vector Store (Internal Docker network in production)
CHROMA_HOST="chroma"
CHROMA_PORT="8000"
CHROMA_SSL="false"

# Production Port Exposure
PORT=80
