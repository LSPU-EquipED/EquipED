{
  "program": "BSIT",
  "objectives": [
    { "code": "IT01", "description": "Able to apply knowledge of computing fundamentals, technical concepts and practices and standards in IT as the \"application of core information technologies, mathematics, science and domain knowledge appropriate for the information technology practice to the abstraction and conceptualization of solution models from defined problems and requirements.\"" },
    { "code": "IT02", "description": "Identify, formulate, research literature, and analyze user needs and taking them into account to solve complex information computing problems, reaching substantiated conclusions using fundamental principles of mathematics, computing fundamentals, technical concepts and practices in the core information technologies and relevant domain principles." },
    { "code": "IT03", "description": "Design and evaluate possible solutions for complex computing problems, and design and evaluate systems, components, or processes that meet specified user needs with appropriate consideration for public health and safety, cultural, societal, and environmental considerations." },
    { "code": "IT04", "description": "Ability to assist in the creation of an effective project plan to implement solution that includes cost estimation, process evaluation and risk management." },
    { "code": "IT05", "description": "Ability to effectively integrate IT-based solutions into the user environment." },
    { "code": "IT06", "description": "Ability to administer delivered information systems to adapt to emerging needs of the user organization by integrating IT-based solutions into the user's environment." },
    { "code": "IT07", "description": "Communicate effectively with the computing community and with society at large (in local and international scenes) about complex computing activities by being able to comprehend and write effective reports, design documentation, make effective presentations, and give and understand clear instructions." },
    { "code": "IT08", "description": "Function effectively as an individual and as a member or leader in diverse teams and in multidisciplinary settings." },
    { "code": "IT09", "description": "Create, select, adapt and apply appropriate techniques resources and modern computing tools to complex computing activities with an understanding of the limitations." },
    { "code": "IT10", "description": "Understand and assess societal, health, safety, legal, and cultural issues within local and global contexts, and the consequential responsibilities relevant to professional responsibilities." },
    { "code": "IT11", "description": "Understands and commits to professional responsibilities, ethics, and norms of professional computing practice." },
    { "code": "IT12", "description": "Recognize the need, and have the ability to engage independent learning for continual development as a computing professional." }
  ],
